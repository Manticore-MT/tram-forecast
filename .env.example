# Copy to .env NEXT TO docker-compose.prod.yml on the server and fill in. Never commit the real .env.

# Required. Generate a fresh one on the server: openssl rand -base64 24
POSTGRES_PASSWORD=

# Required. The host name Caddy serves and gets an HTTPS certificate for; it must resolve to the server.
# For example tram.example.com, or <ip-with-dashes>.sslip.io (a free name that always points at that IP).
DOMAIN=

# Optional
# TRAM_ML_MODE=stub                  # stub = synthetic demo data, http = call the ML service
# TRAM_ML_BASE_URL=http://ml:8000
# TRAM_ML_STUB_ROUTES=3
# TRAM_ML_STUB_STOPS_PER_ROUTE=5
# TRAM_CLOCK_FIXED_INSTANT=2025-11-01T00:00:00Z
# IMAGE_TAG=latest                   # a commit SHA pins a build (rollback)

# Let a frontend on another address (for example a local dev server) call the API from a browser.
# Comma separated origins, or * for any. Leave unset in production: the site and API share one address.
# TRAM_CORS_ALLOWED_ORIGINS=*

# Access control for the API (HTTP Basic on every /api/** request). Off unless enabled here.
# TRAM_AUTH_ENABLED=true
# TRAM_AUTH_USERNAME=
# TRAM_AUTH_PASSWORD=
# TRAM_AUTH_MAX_FAILED_ATTEMPTS=3   # wrong passwords in a row before a client is locked out
# TRAM_AUTH_LOCKOUT=10s             # how long the lockout lasts
