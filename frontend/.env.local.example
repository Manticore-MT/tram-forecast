# Copy to .env.local (not committed) for local development against a separately-running backend
# (e.g. `docker compose up --build` from the repo root, serving on localhost:8080).
# Leave unset for a production build — Caddy serves the frontend and backend from the same
# origin there, so a relative "/api/..." path (the code's default) is correct.
VITE_API_BASE_URL=http://localhost:8080
